+/**
+  Consume one injected failure.
+
+  @param[in,out] Failures  Remaining failure count.
+
+  @retval TRUE   A failure was consumed.
+  @retval FALSE  No failures remain.
+**/
+STATIC
+BOOLEAN
+ConsumeFailure (
+  IN OUT UINTN  *Failures
+  )
+{
+  if (*Failures == 0) {
+    return FALSE;
+  }
+
+  (*Failures)--;
+  return TRUE;
+}
