From b6bd98027d7db289f34fbb71f4ee3e7f591ed9b9 Mon Sep 17 00:00:00 2001
From: appkins <nbatkins@gmail.com>
Date: Tue, 4 Aug 2026 16:59:49 -0500
Subject: [PATCH 25/25] UefiPayloadPkg/CfrSetupMenuDxe: publish CFR options as
 Redfish BIOS attributes

The payload advertises a BIOS schema over the Redfish host interface, but the
only attributes in it are BiosOption1 through BiosOption4 -- the four
placeholders from RedfishClientPkg's own sample form (HiiToRedfishBiosDxe's
HiiToRedfishBiosVfr.vfr). The board's actual settings, the ones coreboot
describes in CFR and this driver renders as the setup menu, are invisible.

That is not a gap in the data. It is that RedfishPlatformConfigDxe decides
whether an HII question is visible to Redfish by looking the question's *prompt
string ID* up a second time, in the "x-UEFI-redfish-<schema>.<version>"
language: if a string exists there its text is the question's Redfish config
language, and if not the question is skipped. Nothing was registering those
strings, so nothing was harvested.

Register one per option, against the same string token the prompt already uses.
The CFR option name is the natural attribute name -- it is already the stable
machine-readable identifier ("power_on_after_fail"), whereas the UI name is
prose and may be translated.

The string package for that language has to be created first. A driver whose
strings are compiled from a .uni gets one per language for free, so this step
normally has no equivalent; the CFR menu is built at runtime from coreboot's
blob and starts life with en-US alone. EFI_HII_STRING_PROTOCOL.SetString only
walks packages that already exist and returns EFI_NOT_FOUND for an unknown
language -- it never creates one, so registering into a fresh language fails
outright:

  CFR: failed to publish "power_on_after_fail" as a Redfish attribute

NewString is the call that does create it, and it also back-fills a blank block
for every string ID already in use, so the new package's token space stays
aligned with en-US. That alignment is what lets SetString then address prompt
tokens minted before the package existed, and it is preserved afterwards
because each later NewString appends a blank to every language.

Those blanks then have to be filled in for the one-of options as well, not just
the question prompts. RedfishPlatformConfigDxe reads an option's name with
HiiGetRedfishString and falls back to the English text only when that returns
NULL -- which it does when the string is *absent*. A blank one is present, so
the fallback is skipped and every enumeration attribute reports

    "CurrentValue": "",
    "DefaultValue": "",

with no error logged anywhere, because nothing failed. (The empty string rather
than JSON null is the tell: BiosAttributeRegistry writes null when the lookup
fails, so "" means it succeeded and found nothing.) Publishing each option's UI
name in the same language restores real values. RedfishClientPkg's own sample
form never hit this because its .uni compiles genuine x-UEFI-redfish strings for
its options.

Upstream-Status: Inappropriate [platform specific]
Signed-off-by: nuc-bios-build <nbatkins@gmail.com>
---
 UefiPayloadPkg/CfrSetupMenuDxe/CfrSetupMenuDxe.inf |  1 +
 UefiPayloadPkg/CfrSetupMenuDxe/SetupMenu.h         | 26 ++++++++++++++++++++++++++
 UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuCfr.c      | 183 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 210 insertions(+)

diff --git a/UefiPayloadPkg/CfrSetupMenuDxe/CfrSetupMenuDxe.inf b/UefiPayloadPkg/CfrSetupMenuDxe/CfrSetupMenuDxe.inf
--- a/UefiPayloadPkg/CfrSetupMenuDxe/CfrSetupMenuDxe.inf
+++ b/UefiPayloadPkg/CfrSetupMenuDxe/CfrSetupMenuDxe.inf
@@ -36,6 +36,7 @@
   HiiLib
   HobLib
   MemoryAllocationLib
+  PrintLib
   VariablePolicyHelperLib
   UefiHiiServicesLib
   UefiLib
diff --git a/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenu.h b/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenu.h
--- a/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenu.h
+++ b/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenu.h
@@ -138,4 +138,30 @@
   OUT EFI_BROWSER_ACTION_REQUEST             *ActionRequest
   );
 
+//
+// Exposing the CFR menu to Redfish.
+//
+// RedfishPlatformConfigDxe treats an HII question as Redfish-visible when the
+// question's prompt string ID also resolves in the
+// "x-UEFI-redfish-<schema>.<version>" language, and takes that string as the
+// question's Redfish config language. Bios.v1_0_9 is the schema
+// edk2-redfish-client's BiosDxe consumes.
+//
+#define CFR_REDFISH_SCHEMA_LANGUAGE   "x-UEFI-redfish-Bios.v1_0_9"
+#define CFR_REDFISH_ATTRIBUTE_PREFIX  L"/Bios/Attributes/"
+
+//
+// Printable name for the string package created to hold the language above.
+// EFI_HII_STRING_PROTOCOL.NewString requires one when it has to create a
+// package for a language the package list does not already carry.
+//
+#define CFR_REDFISH_LANGUAGE_NAME  L"Redfish BIOS attributes"
+
+//
+// Longest config language built from the prefix above plus a CFR option name.
+// CFR names are short machine identifiers; 128 characters is the limit
+// RedfishPlatformConfigDxe itself works to (MAX_X_UEFI_REDFISH_STRING_SIZE).
+//
+#define CFR_REDFISH_CONFIG_LANG_MAX  128
+
 #endif
diff --git a/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuCfr.c b/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuCfr.c
--- a/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuCfr.c
+++ b/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuCfr.c
@@ -15,6 +15,8 @@
 #include <Library/HiiLib.h>
 #include <Library/HobLib.h>
 #include <Library/MemoryAllocationLib.h>
+#include <Library/PrintLib.h>
+#include <Library/UefiHiiServicesLib.h>
 #include <Library/VariablePolicyHelperLib.h>
 #include <Library/UefiRuntimeServicesTableLib.h>
 #include <Guid/CfrSetupMenuGuid.h>
@@ -60,6 +62,182 @@
   }
 }
 
+//
+// Set once the x-UEFI-redfish string package exists on the CFR HII handle.
+//
+STATIC BOOLEAN  mCfrRedfishLanguageReady = FALSE;
+
+/**
+  Make sure this driver's HII package list carries a string package for the
+  x-UEFI-redfish language, so strings can be set in it.
+
+  EFI_HII_STRING_PROTOCOL.SetString only walks string packages that already
+  exist and returns EFI_NOT_FOUND for a language the package list has never
+  carried -- it will not create one. NewString will: handed an unmatched
+  language it allocates a package for it and back-fills a blank block for every
+  string ID already in use, keeping the token space aligned with en-US. That
+  alignment is the point. It is what lets the caller then address a prompt
+  token that was created before this package existed, and it is maintained
+  afterwards because every later NewString appends a blank to each language.
+
+  Strings compiled from a .uni carry every language in the source, so this step
+  has no equivalent in a normal driver; the CFR menu is built at runtime from
+  coreboot's blob and starts out with en-US alone.
+
+  @retval TRUE   The package exists and strings can be set in it.
+  @retval FALSE  It could not be created; the caller should give up.
+**/
+STATIC
+BOOLEAN
+CfrEnsureRedfishStringPackage (
+  VOID
+  )
+{
+  EFI_STATUS     Status;
+  EFI_STRING_ID  Placeholder;
+
+  if (mCfrRedfishLanguageReady) {
+    return TRUE;
+  }
+
+  //
+  // The value is irrelevant -- this call exists for the package it creates as a
+  // side effect. It costs one string ID.
+  //
+  Status = gHiiString->NewString (
+                         gHiiString,
+                         mSetupMenuPrivate.HiiHandle,
+                         &Placeholder,
+                         CFR_REDFISH_SCHEMA_LANGUAGE,
+                         CFR_REDFISH_LANGUAGE_NAME,
+                         L"",
+                         NULL
+                         );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((
+      DEBUG_ERROR,
+      "CFR: cannot create the %a string package - %r\n",
+      CFR_REDFISH_SCHEMA_LANGUAGE,
+      Status
+      ));
+    return FALSE;
+  }
+
+  mCfrRedfishLanguageReady = TRUE;
+  return TRUE;
+}
+
+/**
+  Publish a one-of option's name in the Redfish language.
+
+  Needed because of how CfrEnsureRedfishStringPackage creates that package: it
+  back-fills a *blank* string for every ID already in use, and a blank is not
+  the same as an absent one. RedfishPlatformConfigDxe reads an option's name
+  with HiiGetRedfishString and falls back to the English text only when that
+  returns NULL -- which happens when the string does not exist. An empty string
+  exists, so the fallback is skipped and the attribute's CurrentValue and
+  DefaultValue come out as "" rather than "Enabled".
+
+  Giving every option a real string in that language is what keeps the values
+  readable. The UI name is the right text: it is what the option is called in
+  the setup menu, and Redfish shows it as both the value name and its display
+  name.
+
+  @param[in] StringId  HII string ID of the option's UI name.
+  @param[in] UiName    The option's UI name.
+**/
+STATIC
+VOID
+EFIAPI
+CfrPublishRedfishOptionName (
+  IN EFI_STRING_ID  StringId,
+  IN CHAR16         *UiName
+  )
+{
+  if ((StringId == 0) || (UiName == NULL) || (UiName[0] == CHAR_NULL)) {
+    return;
+  }
+
+  if (!CfrEnsureRedfishStringPackage ()) {
+    return;
+  }
+
+  if (HiiSetString (mSetupMenuPrivate.HiiHandle, StringId, UiName, CFR_REDFISH_SCHEMA_LANGUAGE) == 0) {
+    DEBUG ((DEBUG_ERROR, "CFR: failed to publish option \"%s\" to Redfish\n", UiName));
+  }
+}
+
+/**
+  Publish one CFR option to Redfish as a BIOS attribute.
+
+  RedfishPlatformConfigDxe decides whether an HII question is visible to Redfish
+  by looking that question's *prompt string ID* up a second time, in the
+  "x-UEFI-redfish-<schema>.<version>" language. If a string exists there, its
+  text is the question's Redfish config language and the question is harvested;
+  if not, the question is invisible. So exposing the coreboot CFR menu is a
+  matter of registering a second string against the same token.
+
+  The CFR option name is the natural attribute name: it is already the stable
+  machine-readable identifier ("power_on_after_fail"), as opposed to the UI name
+  which is prose and may be translated.
+
+  Without this the payload advertises a BIOS schema whose only members are the
+  four placeholders from RedfishClientPkg's own sample form -- BiosOption1
+  through BiosOption4 -- while the board's real settings stay invisible.
+
+  @param[in] CfrOptionName   The CFR option's machine name.
+  @param[in] PromptStringId  HII string ID used as the question's prompt.
+**/
+STATIC
+VOID
+EFIAPI
+CfrPublishRedfishAttribute (
+  IN CFR_VARBINARY  *CfrOptionName,
+  IN EFI_STRING_ID  PromptStringId
+  )
+{
+  CHAR16         ConfigLanguage[CFR_REDFISH_CONFIG_LANG_MAX];
+  EFI_STRING_ID  Result;
+
+  if ((CfrOptionName == NULL) || (PromptStringId == 0)) {
+    return;
+  }
+
+  UnicodeSPrint (
+    ConfigLanguage,
+    sizeof (ConfigLanguage),
+    L"%s%a",
+    CFR_REDFISH_ATTRIBUTE_PREFIX,
+    (CHAR8 *)CfrOptionName->data
+    );
+
+  if (!CfrEnsureRedfishStringPackage ()) {
+    return;
+  }
+
+  //
+  // The package list now advertises the x-UEFI-redfish language, which is how
+  // RedfishPlatformConfigDxe discovers this HII handle serves the schema at all;
+  // this string is what makes the individual question visible within it.
+  //
+  Result = HiiSetString (
+             mSetupMenuPrivate.HiiHandle,
+             PromptStringId,
+             ConfigLanguage,
+             CFR_REDFISH_SCHEMA_LANGUAGE
+             );
+  if (Result == 0) {
+    DEBUG ((
+      DEBUG_ERROR,
+      "CFR: failed to publish \"%a\" as a Redfish attribute\n",
+      (CHAR8 *)CfrOptionName->data
+      ));
+    return;
+  }
+
+  DEBUG ((DEBUG_INFO, "CFR: Redfish attribute %s\n", ConfigLanguage));
+}
+
 /**
   CFR_VARBINARY records are used to store a list of dependency values.
   Get a pointer to an array of enum values and its length.
@@ -544,6 +722,8 @@
   CfrConvertVarBinaryToStrings (CfrDisplayName, &HiiDisplayString, &HiiDisplayStringId);
   FreePool (HiiDisplayString);
 
+  CfrPublishRedfishAttribute (CfrOptionName, HiiDisplayStringId);
+
   if (CfrHelpText != NULL) {
     CfrConvertVarBinaryToStrings (CfrHelpText, &HiiHelpText, &HiiHelpTextId);
     FreePool (HiiHelpText);
@@ -566,6 +746,7 @@
       CfrEnumUiString = (CFR_VARBINARY *)((UINT8 *)CfrEnumValues + sizeof (CFR_ENUM_VALUE));
       ASSERT (CfrEnumUiString->tag == CB_TAG_CFR_VARCHAR_UI_NAME);
       CfrConvertVarBinaryToStrings (CfrEnumUiString, &HiiEnumStrings, &HiiEnumStringsId);
+      CfrPublishRedfishOptionName (HiiEnumStringsId, HiiEnumStrings);
       FreePool (HiiEnumStrings);
 
       TempHiiBuffer = HiiCreateOneOfOptionOpCode (
@@ -799,6 +980,8 @@
   CfrConvertVarBinaryToStrings (CfrDisplayName, &HiiDisplayString, &HiiDisplayStringId);
   FreePool (HiiDisplayString);
 
+  CfrPublishRedfishAttribute (CfrOptionName, HiiDisplayStringId);
+
   if (CfrHelpText != NULL) {
     CfrConvertVarBinaryToStrings (CfrHelpText, &HiiHelpText, &HiiHelpTextId);
     FreePool (HiiHelpText);
-- 
