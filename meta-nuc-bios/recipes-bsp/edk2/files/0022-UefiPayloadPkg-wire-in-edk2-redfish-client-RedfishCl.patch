From 76e394e2abf5f4ad62fe74fb37657d2d3113e12c Mon Sep 17 00:00:00 2001
From: appkins <nbatkins@gmail.com>
Date: Tue, 4 Aug 2026 13:06:13 -0500
Subject: [PATCH 22/23] UefiPayloadPkg: wire in edk2-redfish-client
 (RedfishClientPkg)

RedfishPkg discovers the service and produces REST EX; the feature layer that
consumes it -- BiosDxe, BootOptionDxe, ComputerSystemDxe and the JSON
converters -- lives in the separate edk2-redfish-client repository. Wire it in
behind its own REDFISH_CLIENT define, alongside the host-interface stack it
sits on.

RedfishClientPkg/RedfishClient.dsc.inc is deliberately not used wholesale: it
emits a bare [Components] section, and this platform builds -a IA32 -a X64
where every one of these is a DXE driver belonging only in the X64 half. The
granular includes go into [Components.X64] instead.

REDFISH_CLIENT is declared in UefiPayloadPkg's own [Defines], so
RedfishClientDefines.dsc.inc's !ifndef leaves it alone and only supplies
REDFISH_CLIENT_ALL_AUTOGENED = FALSE -- which is what keeps the ~2900
autogenerated schema converters out of the build. Only the schemas named
explicitly in RedfishClientComponents.dsc.inc are built: ComputerSystem,
Bios, AttributeRegistry, BootOption, Memory and SecureBoot.

Upstream-Status: Inappropriate [platform specific]
Signed-off-by: nuc-bios-build <nbatkins@gmail.com>
---
 UefiPayloadPkg/UefiPayloadPkg.dsc | 27 +++++++++++++++++++++++++++
 UefiPayloadPkg/UefiPayloadPkg.fdf |  3 +++
 2 files changed, 30 insertions(+)

diff --git a/UefiPayloadPkg/UefiPayloadPkg.dsc b/UefiPayloadPkg/UefiPayloadPkg.dsc
index 8dce58f5c3..3aaedf0115 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.dsc
+++ b/UefiPayloadPkg/UefiPayloadPkg.dsc
@@ -161,6 +161,13 @@
   #
   DEFINE NETWORK_IPXE_UNDI     = FALSE
 
+  #
+  # edk2-redfish-client (RedfishClientPkg), the feature layer above the host
+  # interface: BiosDxe, BootOptionDxe, ComputerSystemDxe and the JSON
+  # converters. Requires REDFISH_ENABLE; costs roughly 25 extra DXE drivers.
+  #
+  DEFINE REDFISH_CLIENT        = FALSE
+
   # Dfine the maximum size of the capsule image without a reset flag that the platform can support.
   DEFINE MAX_SIZE_NON_POPULATE_CAPSULE = 0xa00000
 
@@ -1044,6 +1051,26 @@
   #
   NucRedfishPkg/RedfishConfigDriver/RedfishConfigDriver.inf
   NucRedfishPkg/NucRedfishSyncDxe/NucRedfishSyncDxe.inf
+
+#
+# edk2-redfish-client. Its own RedfishClient.dsc.inc is not used, because it
+# emits a bare [Components] section: this platform builds -a IA32 -a X64, and
+# every one of these is a DXE driver that belongs only in the X64 half.
+#
+# REDFISH_CLIENT is already defined above, so RedfishClientDefines.dsc.inc's
+# !ifndef leaves it alone and only supplies REDFISH_CLIENT_ALL_AUTOGENED,
+# which keeps the ~2900 autogenerated schema converters out of the build.
+#
+!if $(REDFISH_CLIENT) == TRUE
+[Defines]
+  !include RedfishClientPkg/RedfishClientDefines.dsc.inc
+
+[LibraryClasses]
+  !include RedfishClientPkg/RedfishClientLibs.dsc.inc
+
+[Components.X64]
+  !include RedfishClientPkg/RedfishClientComponents.dsc.inc
+!endif
 !endif
 !endif
 
diff --git a/UefiPayloadPkg/UefiPayloadPkg.fdf b/UefiPayloadPkg/UefiPayloadPkg.fdf
index 749e0bba49..6474cb0f55 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.fdf
+++ b/UefiPayloadPkg/UefiPayloadPkg.fdf
@@ -384,6 +384,9 @@ INF MdeModulePkg/Application/BootManagerMenuApp/BootManagerMenuApp.inf
   INF MdeModulePkg/Bus/Usb/UsbNetwork/UsbCdcEcm/UsbCdcEcm.inf
   INF NucRedfishPkg/RedfishConfigDriver/RedfishConfigDriver.inf
   INF NucRedfishPkg/NucRedfishSyncDxe/NucRedfishSyncDxe.inf
+!if $(REDFISH_CLIENT) == TRUE
+  !include RedfishClientPkg/RedfishClient.fdf.inc
+!endif
 !endif
 !endif
 !endif
