## @file
#  NucRedfishCredentialLib - RedfishPlatformCredentialLib instance speaking
#  HTTP Basic with the PCD credentials, degrading to AuthMethodNone when the
#  user PCD is empty (the JetKVM's unauthenticated RHI default).
#
#  Replaces RedfishPkg's PlatformCredentialLibNull, whose EFI_UNSUPPORTED makes
#  RedfishCreateService fail outright. See the file header for the reasoning and
#  the security boundary this relies on.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION    = 0x0001000b
  BASE_NAME      = NucRedfishCredentialLib
  FILE_GUID      = 5b2e07a1-9d34-4c68-b7f2-8a1e3c05d946
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0
  LIBRARY_CLASS  = RedfishPlatformCredentialLib

[Sources]
  NucRedfishCredentialLib.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  RedfishPkg/RedfishPkg.dec
  NucRedfishPkg/NucRedfishPkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  MemoryAllocationLib
  PcdLib

[Pcd]
  gNucRedfishPkgTokenSpaceGuid.PcdNucRedfishUser        ## CONSUMES
  gNucRedfishPkgTokenSpaceGuid.PcdNucRedfishPassword    ## CONSUMES
