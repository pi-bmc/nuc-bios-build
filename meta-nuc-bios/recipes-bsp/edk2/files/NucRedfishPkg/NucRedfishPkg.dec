## @file
# NucRedfishPkg - platform glue package for standalone EDK2 Redfish drivers
# loaded on the NUC's stock BIOS via a Driver#### load option.
#
# Provides:
#   * A token space for platform PCDs (e.g. the ECM gadget MAC).
#
# SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  DEC_SPECIFICATION = 0x0001001b
  PACKAGE_NAME      = NucRedfishPkg
  PACKAGE_GUID      = 8e9d1a20-3b6c-4f52-9a7e-1c0f2d3e4b50
  PACKAGE_VERSION   = 1.0

[Guids]
  #
  # Token space GUID for this package's PCDs.
  #
  gNucRedfishPkgTokenSpaceGuid = { 0x9f2c4d18, 0x6a3b, 0x4e7d, { 0xb1, 0x2c, 0x5d, 0x8e, 0x0f, 0x3a, 0x6b, 0x71 } }

[PcdsFixedAtBuild]
  #
  # MAC address of the USB CDC-ECM gadget the BMC (JetKVM) presents to the NUC.
  # It MUST equal the real usb0 ECM gadget MAC and MUST also be encoded in
  # gEfiRedfishPkgTokenSpaceGuid.PcdRedfishRestExServiceDevicePath in the DSC.
  #
  # This is host_addr, the MAC the NUC's own CDC-ECM NIC comes up with -- not
  # dev_addr (the BMC's usb0). Both are now derived deterministically from the
  # JetKVM's device ID rather than randomised per boot, so this is a stable
  # value and no longer a hand-configured convention: see
  # internal/usbgadget/ethernet.go, SetEthernetMACSeed/deriveGadgetMAC.
  # Confirmed on hardware 2026-07-29: the NUC enumerates it as enxdaa762233ef5.
  #
  gNucRedfishPkgTokenSpaceGuid.PcdNucRedfishEcmMac|{0xDA, 0xA7, 0x62, 0x23, 0x3E, 0xF5}|VOID*|0x00000001
