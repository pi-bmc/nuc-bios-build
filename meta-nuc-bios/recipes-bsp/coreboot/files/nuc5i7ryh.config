# Base coreboot config for the NUC5i7RYH (board port: mb/intel/nuc5i5ryb,
# Gerrit 94032 -- the i7 kit is the same RYB board with a different soldered
# CPU). Fragments for the payload and the memory-init blobs are appended by
# the recipe; `make olddefconfig` fills in the rest.
CONFIG_VENDOR_INTEL=y
CONFIG_BOARD_INTEL_NUC5I5RYB=y
# Native Broadwell graphics init (Ada/libgfxinit): lights HDMI + mini-DP,
# which is exactly what the JetKVM captures. Needs host gnat to build.
CONFIG_MAINBOARD_USE_LIBGFXINIT=y
# The port's PTT fTPM (board-local TPM2/CRB@0xfed70000) and its CFR setup
# menu are wired by the board Kconfig defaults; nothing to set here. PTT
# requires the factory ME kept in normal mode (BIOS-security jumper / FDO
# off), which is how we flash anyway (BIOS region only).
#
# Use the board's flash map. coreboot only auto-selects an fmd for CHROMEOS
# boards; otherwise CONFIG_FMDFILE is empty and it generates a default 1 MB
# fmap from CBFS_SIZE, leaving ~444 KB of CBFS -- far too small for the EDK2
# payload (ramstage then fails to fit). The port ships board.fmd (BIOS
# 0x1a0000..0x800000: RW_MRC_CACHE + SMMSTORE(PRESERVE) 0x80000 + FMAP +
# CONSOLE + ~5.9 MB COREBOOT/CBFS) but does not wire it, so point at it here.
CONFIG_FMDFILE="src/mainboard/intel/nuc5i5ryb/board.fmd"

# Payload-conditional options: see files/payload-edk2.config. That fragment
# sets CONFIG_PAYLOAD_EDK2 (while still supplying our own prebuilt FV), which
# is what makes the tree's many `if PAYLOAD_EDK2` defaults fire -- the linear
# framebuffer, the board's CFR setup menu, the EFI variable store as option
# backend, TPM_PPI. Nothing to force here.

# This board routes no UART, so a failed boot is otherwise silent: cbmem -c
# needs a booted OS and there is no POST card header. CONSOLE_SPI_FLASH spills
# the log into the CONSOLE FMAP region that board.fmd already reserves, so it
# can be recovered with the SOIC-8 clip:
#     ./scripts/nuc-spi.sh console
# coreboot's own Kconfig help calls this out as the option for "porting a new
# motherboard which has no other console available". It does wear the flash,
# so drop it once the board is known good.
# CONFIG_CONSOLE_SPI_FLASH=y

CONFIG_MRC_SETTINGS_PROTECT=n
CONFIG_DISABLE_ME_PCI=n
