# LinuxBoot payload: the linux-linuxboot bzImage with the u-root initramfs,
# both built in this (nuc-bios) multiconfig and taken from DEPLOY_DIR_IMAGE.
# @BZIMAGE@/@INITRD@ are substituted by the recipe's do_configure.
# NB: the NCT5577D routes no UART on this board -- console=ttyS0 is only
# useful if you wire the SIO's UART pads; otherwise u-root is driven via
# the netconsole/sshd it brings up itself.
CONFIG_PAYLOAD_LINUX=y
CONFIG_PAYLOAD_FILE="@BZIMAGE@"
CONFIG_LINUX_INITRD="@INITRD@"
CONFIG_LINUX_COMMAND_LINE="console=ttyS0,115200 loglevel=7"
