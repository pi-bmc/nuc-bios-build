## @file
# NucRedfishPkg - platform glue package for standalone EDK2 Redfish drivers
# loaded on the NUC's stock BIOS via a Driver#### load option.
#
# Provides:
#   * A token space for platform PCDs (e.g. the ECM gadget MAC).
#
# SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  DEC_SPECIFICATION = 0x0001001b
  PACKAGE_NAME      = NucRedfishPkg
  PACKAGE_GUID      = 8e9d1a20-3b6c-4f52-9a7e-1c0f2d3e4b50
  PACKAGE_VERSION   = 1.0

[Includes]
  Include

[Guids]
  #
  # Token space GUID for this package's PCDs.
  #
  gNucRedfishPkgTokenSpaceGuid = { 0x9f2c4d18, 0x6a3b, 0x4e7d, { 0xb1, 0x2c, 0x5d, 0x8e, 0x0f, 0x3a, 0x6b, 0x71 } }

  #
  # Vendor GUID of the EthCfg variable AND the EthConfigDxe formset (one GUID
  # for both, the ConfigDxe idiom). Ported from the RPi5's BMC-managed IPv4
  # page; see Include/Guid/NucEthConfig.h.
  #
  gNucEthConfigFormSetGuid = { 0x967e2001, 0x25c5, 0x4d1e, { 0xbf, 0x24, 0xb4, 0x22, 0xd8, 0x81, 0xa1, 0xa9 } }

[PcdsFixedAtBuild]
  #
  # MAC address the BMC's USB network gadget assigns to the HOST side
  # (host_addr) -- the MAC the NUC's own CDC NIC comes up with, which the
  # Type 42 record and PcdRedfishRestExServiceDevicePath (in the DSC, patch
  # 0020/0024) must both equal or Redfish discovery never selects the NIC
  # and not a single request is made (observed 2026-09-01).
  #
  # The default is the nanokvm-app RHI contract (RHIHostMAC in
  # pkg/device/usbgadget/usbgadget.go, "da:c0:ff:ee:10:02"; dev side
  # ...:10:01), the same wire contract the RPi5 firmware uses. A
  # JetKVM-managed unit instead derives host_addr from its device ID
  # (internal/usbgadget/ethernet.go deriveGadgetMAC; e.g. DA:A7:62:23:3E:F5
  # for the unit bootstrapped 2026-07-29) -- override this PCD and the DSC
  # device path together when building for one.
  #
  gNucRedfishPkgTokenSpaceGuid.PcdNucRedfishEcmMac|{0xDA, 0xC0, 0xFF, 0xEE, 0x10, 0x02}|VOID*|0x00000001

  #
  # HTTP Basic credentials for the BMC's Redfish service. Empty user means the
  # service is unauthenticated and the credential lib reports AuthMethodNone
  # (the JetKVM's RHI-subnet trust model). A nanokvm-app BMC puts /redfish/v1
  # behind CheckAuth unless authentication is disabled; set both PCDs at build
  # time to speak HTTP Basic, exactly like the RPi5's RpiRedfishCredentialLib.
  #
  gNucRedfishPkgTokenSpaceGuid.PcdNucRedfishUser|""|VOID*|0x00000002
  gNucRedfishPkgTokenSpaceGuid.PcdNucRedfishPassword|""|VOID*|0x00000003
