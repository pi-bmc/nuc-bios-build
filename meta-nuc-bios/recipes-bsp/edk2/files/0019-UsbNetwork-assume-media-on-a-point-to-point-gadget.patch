From f4537dcedfbeb7e8530a66f6181cc1bbc94c645b Mon Sep 17 00:00:00 2001
From: appkins <nbatkins@gmail.com>
Date: Tue, 4 Aug 2026 13:04:05 -0500
Subject: [PATCH 19/24] UsbNetwork: assume media on a point-to-point gadget

edk2's USB-net stack starts CableDetect = 0 and only raises it on catching a
CDC NETWORK_CONNECTION / NETWORK_CONNECTED notification. Linux's f_ecm emits
those only on link-state changes, and the enumeration-time one fires long
before the UEFI driver binds, so it is effectively never set: the first
request over the link fails with EFI_NO_MEDIA.

That model suits a dongle with an RJ45, where the cable really can be absent.
It does not suit a point-to-point gadget, where enumeration *is* the proof of
link -- there is no second connector to unplug.

Default the initialiser to 1, and make the flag sticky thereafter: a host
warm reset makes f_ecm queue a NETWORK_DISCONNECT that the freshly bound
driver reads as "cable unplugged" for the rest of the boot, the matching
CONNECTED having been emitted while nothing was listening.

Upstream-Status: Inappropriate [platform specific]
Signed-off-by: nuc-bios-build <nbatkins@gmail.com>
---
 MdeModulePkg/Bus/Usb/UsbNetwork/NetworkCommon/DriverBinding.c | 2 +-
 MdeModulePkg/Bus/Usb/UsbNetwork/NetworkCommon/PxeFunction.c   | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/MdeModulePkg/Bus/Usb/UsbNetwork/NetworkCommon/DriverBinding.c b/MdeModulePkg/Bus/Usb/UsbNetwork/NetworkCommon/DriverBinding.c
index 3a672a7793..0dff9406e8 100644
--- a/MdeModulePkg/Bus/Usb/UsbNetwork/NetworkCommon/DriverBinding.c
+++ b/MdeModulePkg/Bus/Usb/UsbNetwork/NetworkCommon/DriverBinding.c
@@ -290,7 +290,7 @@ NetworkCommonDriverStart (
 
   NicDevice->NicInfo.UsbEth         = UsbEth;
   NicDevice->NicInfo.MaxSegmentSize = (UINT16)BulkDataSize;
-  NicDevice->NicInfo.CableDetect    = 0;
+  NicDevice->NicInfo.CableDetect    = 1;  // NucRedfish: point-to-point ECM gadget, see wire-redfish.py
   NicDevice->ReceiveBuffer          = ALIGN_POINTER ((VOID *)NicDevice, 4096);
 
   CopyMem ((CHAR8 *)&(NicDevice->NicInfo.MacAddr), (CHAR8 *)&MacAddress, sizeof (MacAddress));
diff --git a/MdeModulePkg/Bus/Usb/UsbNetwork/NetworkCommon/PxeFunction.c b/MdeModulePkg/Bus/Usb/UsbNetwork/NetworkCommon/PxeFunction.c
index 049618b6c6..70b6c8942a 100644
--- a/MdeModulePkg/Bus/Usb/UsbNetwork/NetworkCommon/PxeFunction.c
+++ b/MdeModulePkg/Bus/Usb/UsbNetwork/NetworkCommon/PxeFunction.c
@@ -455,7 +455,7 @@ UndiInitialize (
 
   if (Cdb->OpFlags == PXE_OPFLAGS_INITIALIZE_DETECT_CABLE) {
     if ((Nic->Request.Request == USB_CDC_NETWORK_CONNECTION) && (Nic->Request.Value == NETWORK_DISCONNECT)) {
-      Nic->CableDetect = 0;
+      Nic->CableDetect = 1;  // NucRedfish: link is point-to-point
     } else if ((Nic->Request.Request == USB_CDC_NETWORK_CONNECTION) && (Nic->Request.Value == NETWORK_CONNECTED)) {
       Nic->CableDetect = 1;
     }
@@ -1195,7 +1195,7 @@ UndiGetStatus (
   }
 
   if ((Nic->Request.Request == USB_CDC_NETWORK_CONNECTION) && (Nic->Request.Value == NETWORK_DISCONNECT)) {
-    Nic->CableDetect = 0;
+    Nic->CableDetect = 1;  // NucRedfish: link is point-to-point
   } else if ((Nic->Request.Request == USB_CDC_NETWORK_CONNECTION) && (Nic->Request.Value == NETWORK_CONNECTED)) {
     Nic->CableDetect = 1;
   }
