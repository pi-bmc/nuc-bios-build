diff --git a/UefiPayloadPkg/Library/FmpDeviceSmmLib/FmpDeviceSmmUpdatePolicy.c b/UefiPayloadPkg/Library/FmpDeviceSmmLib/FmpDeviceSmmUpdatePolicy.c
