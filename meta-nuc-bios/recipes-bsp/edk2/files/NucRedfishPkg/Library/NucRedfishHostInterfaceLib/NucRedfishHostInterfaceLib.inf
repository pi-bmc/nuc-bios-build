## @file
#  NucRedfishHostInterfaceLib - RedfishPlatformHostInterfaceLib instance for the
#  NUC <-> BMC USB CDC-ECM link.
#
#  Reports a static Redfish-over-IP host interface record (SMBIOS Type 42h) that
#  points at the BMC's Redfish service on the USB Ethernet gadget. All values are
#  compiled in (no NV variables required) so the driver works on a stock BIOS.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x0001000b
  BASE_NAME                      = NucRedfishHostInterfaceLib
  FILE_GUID                      = 3a5b7c92-1d4e-45af-9c88-2b6e0f13a4d2
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = RedfishPlatformHostInterfaceLib

[Sources]
  NucRedfishHostInterfaceLib.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  RedfishPkg/RedfishPkg.dec
  NucRedfishPkg/NucRedfishPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  PrintLib
  UefiLib
