# EDK2 UefiPayloadPkg payload, built by coreboot's payloads/external/edk2
# machinery (clones the MrChromebox edk2 fork; needs network + nasm).
# The nuc5i5ryb port selects SMMSTORE + the EFI variable store + CFR when
# this payload is chosen, so the fan-profile/Turbo/SATA/fTPM setup options
# surface in the EDK2 UI.
CONFIG_PAYLOAD_EDK2=y
