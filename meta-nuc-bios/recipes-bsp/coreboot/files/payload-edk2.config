# EDK2 UefiPayloadPkg payload, built by COREBOOT'S OWN payloads/external/edk2
# machinery, with iPXE likewise built by payloads/external/iPXE and embedded in
# the payload FV. Everything below maps 1:1 onto symbols in
#   payloads/external/edk2/Kconfig
#   payloads/external/iPXE/Kconfig
# so the tuning lives where coreboot expects it instead of being re-implemented.
#
# There is deliberately NO CONFIG_PAYLOAD_FILE here: inside `if PAYLOAD_EDK2`
# it defaults to $(obj)/UEFIPAYLOAD.fd, which is the file rule that drives the
# edk2 build. Overriding it would silently bypass that build.
#
# Consequences of building edk2/iPXE here rather than in Yocto recipes:
#   * coreboot's do_compile clones edk2 (with submodules) and iPXE over the
#     network. do_compile[network] is already set for the coreboot submodules.
#   * The clones live under payloads/external/ in the recipe WORKDIR, not in
#     DL_DIR, so they are not shared with other builds and are refetched after
#     a cleansstate.
#   * edk2/iPXE no longer appear as separate recipes, so they are outside
#     Yocto's license/SPDX accounting. EDK2_TAG_OR_REV below keeps the tree
#     pinned; iPXE is pinned only to a branch by coreboot's own Kconfig.
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_UEFIPAYLOAD=y

# Same fork and revision the edk2-uefipayload recipe used to pin, so the
# payload contents do not change as a side effect of this transition.
CONFIG_EDK2_REPO_MRCHROMEBOX=y
CONFIG_EDK2_TAG_OR_REV="2939f4969466bfe71722494e4cea5cbaa029c709"

# --- iPXE, built by coreboot and embedded in the FV as an FFS -------------
# EDK2_ENABLE_IPXE selects PXE and defaults IPXE_BUILD_EFI=y, so iPXE is built
# for the EFI target and copied to UefiPayloadPkg/NetworkDrivers/ipxe.efi.
# No PCI id is involved: the UEFI driver model binds it at runtime. (The old
# CBFS pci<vid>,<did>.rom route could never work here -- coreboot's
# pci_rom_run() returns early for anything that is not PCI_CLASS_DISPLAY_VGA,
# so a LOM's option ROM is never loaded. Confirmed on hardware 2026-07-28.)
CONFIG_EDK2_ENABLE_IPXE=y
CONFIG_IPXE_MASTER=y
# Deliberately a single word. coreboot emits
#     --pcd ...PcdiPXEOptionName=L"$(CONFIG_EDK2_IPXE_OPTION_NAME)"
# and Kconfig keeps the quotes on string values, so a value containing spaces
# reaches edk2's build.py mangled. Measured against this fork: the doubled
# L""..."" form is rejected outright with
#     error 3000: PCD [...PcdiPXEOptionName] ... Syntax error
CONFIG_EDK2_IPXE_OPTION_NAME="iPXE"

# --- payload tuning (payloads/external/edk2/Kconfig) ----------------------
# Headless box driven over the JetKVM: give the operator a beat, and accept
# Esc as well as F2 for Setup. (coreboot defaults: 2 seconds, Esc off.)
CONFIG_EDK2_BOOT_TIMEOUT=3
CONFIG_EDK2_BOOT_MANAGER_ESCAPE=y

# The NCT5577D routes no UART on this board (NO_UART_ON_SUPERIO), so the
# firmware console goes to the cbmem ring -- read it with `cbmem -c`.
# CONFIG_EDK2_SERIAL_SUPPORT is not set
CONFIG_EDK2_CBMEM_LOGGING=y

# The ME PTT fTPM's CRB is at the non-standard 0xfed70000; edk2's TCG stack
# only probes 0xfed40000 and would find nothing. The OS gets the TPM through
# the board port's ACPI TPM2 table instead. (coreboot defaults this n.)
CONFIG_EDK2_DISABLE_TPM=y

# LvglPkg's vendored lvgl does not compile against this host's GCC -- edk2
# builds with -Werror and GCC 16 rejects upstream lvgl:
#   lvgl/src/widgets/buttonmatrix/lv_buttonmatrix.c:1034:14: error:
#   variable 'txt_tot_i' set but not used [-Werror=unused-but-set-variable=]
# Without it the payload uses the text renderer, which is what this board has
# been running. coreboot defaults this y when serial is off.
# CONFIG_EDK2_USE_LVGL_RENDERER is not set

# Broadwell has no CPUID leaf 15h crystal clock, so the TSC-from-CPUID timer
# lib (Skylake+) must stay off; the Makefile then emits
# -D CPU_TIMER_LIB_ENABLE=FALSE. This is also coreboot's default -- stated
# explicitly because getting it wrong hangs the payload.
# CONFIG_EDK2_CPU_TIMER_LIB is not set

# Left at coreboot's defaults, listed so the whole surface is visible:
#   EDK2_SECURE_BOOT_SUPPORT  y (MrChromebox fork + SMMSTORE) -- ships in setup
#                               mode, so it does not block unsigned OSes
#   EDK2_HAVE_EFI_SHELL       y -- keep the shell as a rescue path
#   EDK2_FULL_SCREEN_SETUP    y -- use the whole libgfxinit framebuffer
#   EDK2_PS2_SUPPORT          y
#   EDK2_PRIORITIZE_INTERNAL  y -- internal storage ahead of removable
#   EDK2_SD_MMC_TIMEOUT       10 (seconds; the Makefile multiplies by 1000)
#   EDK2_LOAD_OPTION_ROMS     n -- cannot help a LOM, see pci_rom_run() above

# SMMSTORE sized to the port's SMMSTORE(PRESERVE) FMAP region in board.fmd.
# With PAYLOAD_EDK2 set, the board's `select ... if PAYLOAD_EDK2 && SMMSTORE`
# lines fire on their own (CFR setup menu + EFI variable store), and the
# option-backend choice defaults to USE_UEFI_VARIABLE_STORE.
CONFIG_SMMSTORE=y
CONFIG_SMMSTORE_SIZE=0x80000
