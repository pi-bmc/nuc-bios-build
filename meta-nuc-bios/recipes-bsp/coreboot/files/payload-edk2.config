# EDK2 UefiPayloadPkg payload, built by COREBOOT'S OWN payloads/external/edk2
# machinery, with iPXE likewise built by payloads/external/iPXE and embedded in
# the payload FV. Everything below maps 1:1 onto symbols in
#   payloads/external/edk2/Kconfig
#   payloads/external/iPXE/Kconfig
# so the tuning lives where coreboot expects it instead of being re-implemented.
#
# There is deliberately NO CONFIG_PAYLOAD_FILE here: inside `if PAYLOAD_EDK2`
# it defaults to $(obj)/UEFIPAYLOAD.fd, which is the file rule that drives the
# edk2 build. Overriding it would silently bypass that build.
#
# Consequences of building edk2/iPXE here rather than in Yocto recipes:
#   * coreboot's do_compile clones edk2 (with submodules) and iPXE over the
#     network. do_compile[network] is already set for the coreboot submodules.
#   * The clones live under payloads/external/ in the recipe WORKDIR, not in
#     DL_DIR, so they are not shared with other builds and are refetched after
#     a cleansstate.
#   * edk2/iPXE no longer appear as separate recipes, so they are outside
#     Yocto's license/SPDX accounting. EDK2_TAG_OR_REV below keeps the tree
#     pinned; iPXE is pinned only to a branch by coreboot's own Kconfig.
# EDK2 UefiPayloadPkg payload -- built by the edk2-uefipayload recipe, NOT by
# coreboot's payloads/external/edk2 machinery.
#
# PAYLOAD_EDK2 deliberately stays ON even though coreboot does not build the
# payload any more. It is load-bearing beyond selecting a build:
#
#   src/drivers/option/Kconfig:6
#     select DRIVERS_EFI_VARIABLE_STORE if PAYLOAD_EDK2 && SMMSTORE
#
# Turning it off would silently drop the EFI variable store, and with it the
# option backend the CFR setup menu writes through -- the board would build
# fine and lose its settings UI at runtime.
#
# Overriding PAYLOAD_FILE is enough to stop coreboot building edk2: the make
# rule is keyed on the output path,
#
#   payloads/external/Makefile.mk:198
#     $(obj)/UEFIPAYLOAD.fd: $(DOTCONFIG) $(IPXE_EFI)
#
# so pointing PAYLOAD_FILE at an already-built file elsewhere leaves make with
# no rule to run. The generic CBFS wiring does the rest, unchanged:
#
#   $(CONFIG_CBFS_PREFIX)/payload-file := $(CONFIG_PAYLOAD_FILE)
#   $(CONFIG_CBFS_PREFIX)/payload-type := payload
#
# "-type := payload" is what makes cbfstool convert the 12 MiB firmware volume
# into a payload ELF, discarding the FV's empty padding. Measured 2026-07-29:
# 12,582,968 bytes of .fd becomes a 2,648,202-byte CBFS entry.
CONFIG_PAYLOAD_EDK2=y
CONFIG_PAYLOAD_FILE="@UEFIPAYLOAD@"

# Required: with compression "none" cbfstool adds the .fd raw and it does not
# fit (largest CBFS slot is ~5.2 MB against a 12 MB file).
CONFIG_COMPRESSED_PAYLOAD_LZMA=y

# SMMSTORE sized to the port's SMMSTORE(PRESERVE) FMAP region in board.fmd.
CONFIG_SMMSTORE=y
CONFIG_SMMSTORE_SIZE=0x80000

# All EDK2_* build tuning (network, Redfish, iPXE, timers, Secure Boot, the
# cbmem console) now lives in meta-nuc-bios/recipes-bsp/edk2/, which is what
# lets NucRedfishPkg be staged as ordinary layer files. Setting those symbols
# here would have no effect -- coreboot never invokes the edk2 build.

# --- UEFI capsule updates -------------------------------------------
# DRIVERS_EFI_UPDATE_CAPSULES is required even though we never use
# coreboot's CapsuleUpdateData*/CBMEM capsule parser: it is what unlocks
# full-flash access in the SMMSTORE SMI handler. src/drivers/smmstore/store.c
# only returns boot_device_rw() -- the whole chip -- from
# lookup_store_region() when this is set, and wraps the entire
# SMMSTORE_CMD_USE_FULL_FLASH handshake in the same CONFIG() test. Without
# it FmpDeviceSmmLib is confined to the 512K SMMSTORE FMAP region and
# cannot reach the BIOS region at all.
CONFIG_DRIVERS_EFI_UPDATE_CAPSULES=y

# ESRT identity. The GUID must equal the payload's CAPSULE_MAIN_FW_GUID,
# the capsule's GUID and the ESRT entry -- four places, one value.
# coreboot's default is the placeholder 00112233-4455-6677-8899-aabbccddeeff.
CONFIG_DRIVERS_EFI_FW_INFO=y
CONFIG_DRIVERS_EFI_MAIN_FW_GUID="d25f89e1-94ec-4533-80b9-7f8855ce0a94"
CONFIG_DRIVERS_EFI_MAIN_FW_VERSION=0x00000001
CONFIG_DRIVERS_EFI_MAIN_FW_LSV=0x00000001

# Capsule generation stays OFF: DRIVERS_EFI_GENERATE_CAPSULE assumes
# coreboot builds edk2 in payloads/external, and ours consumes a prebuilt
# UEFIPAYLOAD.fd via PAYLOAD_FILE. The capsule is generated in the edk2
# recipe instead. EMBED_FMP_DXE/ACCEPT_EMBEDDED_DRIVERS stay off with it --
# SECURE_BOOT_ENABLE=TRUE would require the embedded driver to be signed by
# a trusted key, and FmpDxe is FV-resident here instead.
# CONFIG_DRIVERS_EFI_GENERATE_CAPSULE is not set
