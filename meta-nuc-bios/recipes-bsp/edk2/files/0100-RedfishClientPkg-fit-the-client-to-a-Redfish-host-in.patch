From ac1a2dd533a2f2c1783cedb22932df3356e0e783 Mon Sep 17 00:00:00 2001
From: appkins <nbatkins@gmail.com>
Date: Tue, 4 Aug 2026 15:10:34 -0500
Subject: [PATCH] RedfishClientPkg: fit the client to a Redfish host interface

Two changes for a platform where the BMC is reached over DSP0270's
point-to-point USB link and serves exactly one managed host.

1. Accept the single ComputerSystem.

RedfishResourceIdentifyLibComputerSystem exists to pick this host's own
ComputerSystem out of a BMC that manages several, by matching the resource's
UUID against SMBIOS type 1. On a host interface that is the wrong question:
one host, one system, nothing to disambiguate. It is also unanswerable here --
coreboot leaves the type 1 UUID unset ("Not Settable" in dmidecode), so the
library returns EFI_NOT_FOUND and the collection member is skipped:

    RedfishResourceIdentify: identify /redfish/v1/Systems/1 failed: Unsupported
    HandleResource: "/redfish/v1/Systems/1" is not handled by us
    StartUpFeatureDriver: No InformationTypeCollectionMemberConfigLanguage of Systems returned.

which stops the whole ComputerSystem feature before it starts. Resolve
RedfishResourceIdentifyLib to the Null instance, which accepts the resource.

2. Drop the Memory feature.

MemoryDxe has no SMBIOS dependency -- its INF lists no gEfiSmbiosProtocolGuid
and no SMBIOS library. Its only data source is
EDKII_REDFISH_PLATFORM_CONFIG_PROTOCOL, i.e. HII questions in the
"x-UEFI-redfish-Memory.v1_7_1" namespace. But Memory is inventory, not
configuration, so no platform publishes DIMMs as BIOS setup questions. The
driver walks all 38 schema properties, misses every one, and POSTs an empty
resource:

    RedfishPlatformConfigGetStatementCommon: No match HII statement is found
      by the given /Memory/{1}/CapacityMiB in schema x-UEFI-redfish-Memory.v1_7_1
    ... x37 more ...
    RedfishPostResource: Post URI: /redfish/v1/Systems/1/Memory

Left enabled it creates one empty member per DIMM, which is worse than nothing:
it looks like inventory and contains none. NucRedfishSyncDxe reports the real
modules from SMBIOS type 17 instead -- the same place it already gets
BiosVersion, Manufacturer, Model and SerialNumber, and the same records the OS
reads.

Upstream-Status: Inappropriate [platform specific]
Signed-off-by: nuc-bios-build <nbatkins@gmail.com>
---
 RedfishClientPkg/RedfishClient.fdf.inc        |  9 ++--
 .../RedfishClientComponents.dsc.inc           | 46 ++++++++++++++++---
 2 files changed, 44 insertions(+), 11 deletions(-)

diff --git a/RedfishClientPkg/RedfishClient.fdf.inc b/RedfishClientPkg/RedfishClient.fdf.inc
index 62063a93..101d4856 100644
--- a/RedfishClientPkg/RedfishClient.fdf.inc
+++ b/RedfishClientPkg/RedfishClient.fdf.inc
@@ -16,13 +16,14 @@
   INF RedfishClientPkg/RedfishFeatureCoreDxe/RedfishFeatureCoreDxe.inf
   INF RedfishClientPkg/RedfishETagDxe/RedfishETagDxe.inf
   INF RedfishClientPkg/RedfishConfigLangMapDxe/RedfishConfigLangMapDxe.inf
-  INF RedfishClientPkg/Features/Memory/V1_7_1/Dxe/MemoryDxe.inf
-  INF RedfishClientPkg/Features/MemoryCollectionDxe/MemoryCollectionDxe.inf
+  #
+  # The Memory feature is deliberately absent -- see the note in
+  # RedfishClientComponents.dsc.inc.
+  #
   INF RedfishClientPkg/Features/ComputerSystem/v1_5_0/Dxe/ComputerSystemDxe.inf
   INF RedfishClientPkg/Features/ComputerSystemCollectionDxe/ComputerSystemCollectionDxe.inf
   INF RedfishClientPkg/Features/Bios/v1_0_9/Dxe/BiosDxe.inf
   INF RedfishClientPkg/Features/BiosAttributeRegistry/v1_3_6/BiosAttributeRegistryDxe.inf
-  INF RedfishClientPkg/HiiToRedfishMemoryDxe/HiiToRedfishMemoryDxe.inf
   INF RedfishClientPkg/HiiToRedfishBootDxe/HiiToRedfishBootDxe.inf
   INF RedfishClientPkg/HiiToRedfishBiosDxe/HiiToRedfishBiosDxe.inf
   INF RedfishClientPkg/Features/BootOptionCollection/BootOptionCollectionDxe.inf
@@ -34,8 +35,6 @@
   #
   # Below two modules should be pulled in by build tool.
   #
-  INF RedfishClientPkg/Converter/Memory/v1_7_1/RedfishMemory_V1_7_1_Dxe.inf
-  INF RedfishClientPkg/Converter/MemoryCollection/RedfishMemoryCollection_Dxe.inf
   INF RedfishClientPkg/Converter/ComputerSystem/v1_5_0/RedfishComputerSystem_V1_5_0_Dxe.inf
   INF RedfishClientPkg/Converter/ComputerSystemCollection/RedfishComputerSystemCollection_Dxe.inf
   INF RedfishClientPkg/Converter/Bios/v1_0_9/RedfishBios_V1_0_9_Dxe.inf
diff --git a/RedfishClientPkg/RedfishClientComponents.dsc.inc b/RedfishClientPkg/RedfishClientComponents.dsc.inc
index 6cb20be7..05282c3f 100644
--- a/RedfishClientPkg/RedfishClientComponents.dsc.inc
+++ b/RedfishClientPkg/RedfishClientComponents.dsc.inc
@@ -18,7 +18,28 @@
   RedfishClientPkg/RedfishFeatureCoreDxe/RedfishFeatureCoreDxe.inf
   RedfishClientPkg/RedfishETagDxe/RedfishETagDxe.inf
   RedfishClientPkg/RedfishConfigLangMapDxe/RedfishConfigLangMapDxe.inf
-  RedfishClientPkg/HiiToRedfishMemoryDxe/HiiToRedfishMemoryDxe.inf
+  #
+  # The Memory feature is deliberately absent.
+  #
+  # MemoryDxe has no SMBIOS dependency: its only data source is
+  # EDKII_REDFISH_PLATFORM_CONFIG_PROTOCOL, i.e. HII questions in the
+  # "x-UEFI-redfish-Memory.v1_7_1" namespace. Memory is inventory, not
+  # configuration, so no platform publishes DIMMs as BIOS setup questions --
+  # and this one certainly does not. The driver therefore walks all 38 schema
+  # properties, misses every single one, and POSTs an empty resource:
+  #
+  #   RedfishPlatformConfigGetStatementCommon: No match HII statement is found
+  #     by the given /Memory/{1}/CapacityMiB in schema x-UEFI-redfish-Memory.v1_7_1
+  #   ... x37 more ...
+  #   RedfishPostResource: Post URI: /redfish/v1/Systems/1/Memory
+  #
+  # Left enabled it creates one empty member per DIMM, which is worse than
+  # nothing: it looks like inventory and contains none.
+  #
+  # NucRedfishSyncDxe reports the real modules from SMBIOS type 17 instead --
+  # the same place it already gets BiosVersion, Manufacturer, Model and
+  # SerialNumber, and the same records the OS reads.
+  #
   RedfishClientPkg/HiiToRedfishBootDxe/HiiToRedfishBootDxe.inf
   RedfishClientPkg/HiiToRedfishBiosDxe/HiiToRedfishBiosDxe.inf
   RedfishClientPkg/RedfishTaskServiceDxe/RedfishTaskServiceDxe.inf
@@ -26,11 +47,26 @@
   #
   # Below two modules should be pulled in by build tool.
   #
-  RedfishClientPkg/Features/Memory/V1_7_1/Dxe/MemoryDxe.inf
-  RedfishClientPkg/Features/MemoryCollectionDxe/MemoryCollectionDxe.inf
+  #
+  # RedfishResourceIdentifyLibComputerSystem picks this host's ComputerSystem
+  # out of a BMC that manages several, by matching the resource's UUID against
+  # SMBIOS type 1. That is the wrong question on a Redfish host interface
+  # (DSP0270): the link is point-to-point to exactly one host and the service
+  # exposes exactly one ComputerSystem, so there is nothing to disambiguate.
+  #
+  # It is also unanswerable on this board -- coreboot leaves the type 1 UUID
+  # unset ("Not Settable" in dmidecode), so there is no GUID to compare and
+  # the library returns EFI_NOT_FOUND. The member is then skipped, which stops
+  # the whole ComputerSystem feature before it starts:
+  #
+  #   RedfishResourceIdentify: identify /redfish/v1/Systems/1 failed: Unsupported
+  #   HandleResource: "/redfish/v1/Systems/1" is not handled by us
+  #
+  # Fall back to the Null instance, which accepts the resource.
+  #
   RedfishClientPkg/Features/ComputerSystem/v1_5_0/Dxe/ComputerSystemDxe.inf {
     <LibraryClasses>
-      RedfishResourceIdentifyLib|RedfishClientPkg/Library/RedfishResourceIdentifyLibComputerSystem/v1_5_0/RedfishResourceIdentifyLibComputerSystem.inf
+      RedfishResourceIdentifyLib|RedfishClientPkg/Library/RedfishResourceIdentifyLibNull/RedfishResourceIdentifyLibNull.inf
   }
   RedfishClientPkg/Features/ComputerSystemCollectionDxe/ComputerSystemCollectionDxe.inf
   RedfishClientPkg/Features/Bios/v1_0_9/Dxe/BiosDxe.inf
@@ -44,8 +80,6 @@
   #
   # Below two modules should be pulled in by build tool.
   #
-  RedfishClientPkg/Converter/Memory/v1_7_1/RedfishMemory_V1_7_1_Dxe.inf
-  RedfishClientPkg/Converter/MemoryCollection/RedfishMemoryCollection_Dxe.inf
   RedfishClientPkg/Converter/ComputerSystem/v1_5_0/RedfishComputerSystem_V1_5_0_Dxe.inf
   RedfishClientPkg/Converter/ComputerSystemCollection/RedfishComputerSystemCollection_Dxe.inf
   RedfishClientPkg/Converter/Bios/v1_0_9/RedfishBios_V1_0_9_Dxe.inf
-- 
